# Copy to .env.local and fill in from Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Your live address, e.g. https://caseroom.app (sign-in links point here)
NEXT_PUBLIC_SITE_URL=
# Server only. Used by the AI checker to write AI checks. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# AI helper (task drafting, source checks, daily summary)
ANTHROPIC_API_KEY=
